<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Danh sách sinh viên</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Danh sách sinh viên</h1>

    <a href="/crud" class="btn">Thêm sinh viên</a>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Mã SV</th>
          <th>Họ tên</th>
          <th>Email</th>
          <th>SĐT</th>
          <th>Lớp</th>
          <th>Chuyên ngành</th>
          <th>Thao tác</th>
        </tr>
      </thead>

      <tbody>
        <% if (datalist && datalist.length > 0) { %>
          <% datalist.forEach(function(student) { %>
            <tr>
              <td><%= student.id %></td>
              <td><%= student.studentCode %></td>
              <td><%= student.fullName %></td>
              <td><%= student.email %></td>
              <td><%= student.phoneNumber %></td>
              <td><%= student.className %></td>
              <td><%= student.major %></td>
              <td>
                <a href="/edit-crud?id=<%= student.id %>" class="btn-small">Sửa</a>
                <a 
                  href="/delete-crud?id=<%= student.id %>" 
                  class="btn-small btn-delete"
                  onclick="return confirm('Bạn có chắc muốn xóa sinh viên này?')"
                >
                  Xóa
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8">Chưa có sinh viên nào.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>